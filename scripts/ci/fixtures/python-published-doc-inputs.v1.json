  "sdk_version": "6.9.0",
  "inputs": {
    "n6_recorder.py": {
      "bytes": 517,
      "sha256": "a91cfe6c6da514dcbf0a2957da7e9b80be62eb4905b80448ccacfd080b35ed3e",
      "text": "\"\"\"N6 recorder: non-literal capture of full SDK reports. Not a quickstart snippet.\"\"\"\nimport json\nimport sys\n\nfrom assay import Coverage, validate\n\nwith open(\"traces.jsonl\") as f:\n    traces = [json.loads(line) for line in f]\n\nreports = {\n    \"validate_default\": validate(policy_path=\"assay.yaml\", traces=traces),\n    \"coverage_min_90\": Coverage(\"assay.yaml\").analyze(traces=[traces], min_coverage=90.0),\n}\nwith open(sys.argv[1], \"x\") as out:\n    json.dump(reports, out, indent=2, sort_keys=True)\n    out.write(\"\\n\")\n"
    },
    "conftest.py": {
      "bytes": 175,
      "sha256": "ba7cc1307ce9ee81477a152ac6b5fb29d7c9214b9f094a87af38f3c68758914a",
      "text": "# conftest.py\nimport pytest\n\n@pytest.fixture\ndef assay_client(tmp_path):\n    from assay import AssayClient\n    return AssayClient(trace_file=str(tmp_path / \"live_run.jsonl\"))\n"
    },
    "test_coverage.py": {
      "bytes": 590,
      "sha256": "7d84e2aa493b145c69beb1071a193746b280a601884b123c0a62bc3d13f98ff1",
      "text": "import json\nfrom assay import Coverage\n\ndef test_coverage():\n    # Load the same JSONL the validate() example uses.\n    with open(\"traces.jsonl\") as f:\n        traces = [json.loads(line) for line in f]\n    # analyze() needs a list of sessions; it does not wrap a flat list of events\n    my_traces = [traces]\n\n    cov = Coverage(\"assay.yaml\")\n\n    # Analyze with a minimum coverage threshold of 90%\n    report = cov.analyze(traces=my_traces, min_coverage=90.0)\n\n    # overall_coverage_pct is the coverage percentage; there is no score field\n    assert report[\"overall_coverage_pct\"] >= 90.0\n"
    },
    "test_agent.py": {
      "bytes": 148,
      "sha256": "e3b912906019bb2577df0ac2e1b47b0c73935fe68b35d8104e46bc78fc5cbdeb",
      "text": "# test_agent.py\ndef test_agent_run(assay_client):\n    # ... agent logic ...\n    assay_client.record_trace({\"tool\": \"search\", \"args\": {\"q\": \"foo\"}})\n"
    },
    "positive-traces.jsonl": {
      "bytes": 60,
      "sha256": "0bfbefb54871c9ae61b10de3c501ece60cf347f99a2d85db31cb47158cafa7cd",
      "text": "{\"tool\": \"ToolA\", \"args\": {}}\n{\"tool\": \"ToolB\", \"args\": {}}\n"
    },
    "positive-assay.yaml": {
      "bytes": 71,
      "sha256": "8bf949341f48edebf994666c09ac6f8d21ab5297a4e8adeef912cb090ede0bec",
      "text": "version: \"1\"\nname: test_policy\ntools:\n  allow:\n    - ToolA\n    - ToolB\n"
    },
    "contrast-assay.yaml": {
      "bytes": 528,
      "sha256": "7c4228b71f543c560865345e9b66d9cdb4beff1e3dcc776921865f0fb9767353",
      "text": "version: \"1.1\"\nname: rule_parity\ntools:\n  allow: [Search, Create, Notify, Read, Post, Audit]\nsequences:\n  - type: before\n    first: Search\n    then: Create\n  - type: never_after\n    trigger: Read\n    forbidden: Post\n  - type: require\n    tool: Audit\n  - type: max_calls\n    tool: Search\n    max: 3\n  - type: sequence\n    tools: [Search, Create, Notify]\n    strict: false\n  - type: blocklist\n    pattern: drop_\n  - type: after\n    trigger: Create\n    then: Notify\n    within: 2\n  - type: eventually\n    tool: Audit\n    within: 5\n"
    },
    "test_validate.py": {
      "bytes": 593,
      "sha256": "80a6c8da5c3e593073f856f7cab324d18a5651eee057afbfa2bbf5f6799f0019",
      "text": "import json\nimport pytest\nfrom assay import validate\n\ndef test_compliance():\n    # 1. Load your agent's trace logs\n    with open(\"traces.jsonl\") as f:\n        traces = [json.loads(line) for line in f]\n\n    # 2. Analyze coverage of your policy\n    # Returns Coverage.analyze() unchanged: a CoverageReport dict\n    # (meets_threshold, overall_coverage_pct, threshold)\n    report = validate(\n        policy_path=\"assay.yaml\",\n        traces=traces\n    )\n\n    # 3. Assert the coverage threshold\n    assert report[\"meets_threshold\"], \\\n        f\"Coverage is below threshold {report['threshold']}.\"\n"
    },
    "contrast-traces.jsonl": {
      "bytes": 224,
      "sha256": "a4fc367d82317c8bd31aa68f9e88a301fab04e05da906164001c9924551be0b4",
      "text": "{\"type\": \"call_tool\", \"tool\": \"Search\", \"test_id\": \"A\"}\n{\"type\": \"call_tool\", \"tool\": \"Create\", \"test_id\": \"A\"}\n{\"type\": \"call_tool\", \"tool\": \"Notify\", \"test_id\": \"A\"}\n{\"type\": \"call_tool\", \"tool\": \"Search\", \"test_id\": \"B\"}\n"
    }
  },
