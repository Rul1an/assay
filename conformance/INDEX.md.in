```json
{
  "not_derived": [
    {"token": "100%", "reason": "the adequacy bar itself, not a result"},
    {"token": "4 of 4", "reason": "the superseded first mcp-jsonrpc-id score"},
    {"token": "4 of 5", "reason": "the superseded first observed-effect score"},
    {"token": "30 of 30", "reason": "the superseded first rge-bench score"},
    {"token": "50%", "reason": "the superseded privileged-action score over eight declared rules"},
    {"token": "6 of 8", "reason": "the contaminated run that motivated the exclusive lock"},
    {"token": "75.0%", "reason": "the percentage from that contaminated run"},
    {"token": "4 of 8", "reason": "the clean rerun of that superseded declaration"},
    {"token": "8 of 31", "reason": "the RFC 8785 control divergence count, not a mutation score"},
    {"token": "one not measurable", "reason": "mcp-era-parity-v0 has no per-vector verdict and therefore no measurable row"}
  ]
}
```

